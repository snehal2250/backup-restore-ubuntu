# Captured configuration output from backup.sh — can contain secrets, keep out of git.
backups/

# Transactional staging + artifact tracker written during a backup run. backup.sh
# cleans both on the next run, but a crashed/interrupted run leaves them behind —
# backups.staging/ can hold thousands of captured files. Never commit them.
backups.staging/
backups.artifacts

# Runtime flock lock file (created while a backup run is active).
.backup.lock

# Test sandboxes — tests/helpers.sh creates scratch dirs under the repo root
# (the snap-packaged yq cannot read /tmp).
.test-tmp.*

# Effective (catalog-resolved) inventory written by resolve_effective_inventory
# (lib/common.sh) when the inventory uses `catalog:` references (schema v5).
.inventory-resolve.*

# Transient scratch from inventory.sh (add-app catalog refs, review --drift)
# and the app/service wizards — removed on success; ignore leftovers from
# interrupted runs.
.app-ref.*
.app-entry.*
.service-entry.*
.drift-tmpl.*
.drift-decl.*
